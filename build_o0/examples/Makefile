	@echo "... rmi_server_example.i"
	@echo "... rmi_server_example.s"
	@echo "... rmi_stdio_client_example.o"
	@echo "... rmi_stdio_client_example.i"
	@echo "... rmi_stdio_client_example.s"
	@echo "... rmi_stdio_server_example.o"
	@echo "... rmi_stdio_server_example.i"
	@echo "... rmi_stdio_server_example.s"
.PHONY : help



#=============================================================================
# Special targets to cleanup operation of make.

# Special rule to run CMake to check the build system integrity.
# No rule that depends on this can have commands that come from listfiles
# because they might be regenerated.
cmake_check_build_system:
	cd /home/runner/work/bison/bison/build_o0 && $(CMAKE_COMMAND) -S$(CMAKE_SOURCE_DIR) -B$(CMAKE_BINARY_DIR) --check-build-system CMakeFiles/Makefile.cmake 0
.PHONY : cmake_check_build_system

